	</ComponentGroup>

	<!-- fldigi sidecar payload: prebuilt exe + runtime DLLs shipped from the
	     git-tracked payload\Fldigi folder.  Installed to [INSTALLFOLDER]\Fldigi
	     so FldigiManager.ResolveExecutable() resolves them as the primary probe.
	     Refresh payload\Fldigi on every fldigi rebuild. -->
	<ComponentGroup Id="FldigiComponents" Directory="FldigiDir">
		<Component Guid="*"><File Id="FldigiEXE" Source="$(var.FldigiPath)fldigi.exe" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibFLAC" Source="$(var.FldigiPath)libFLAC.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibfltk14" Source="$(var.FldigiPath)libfltk-1.4.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibfltkForms14" Source="$(var.FldigiPath)libfltk_forms-1.4.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibfltkGL14" Source="$(var.FldigiPath)libfltk_gl-1.4.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibfltkImages14" Source="$(var.FldigiPath)libfltk_images-1.4.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibgccseh1" Source="$(var.FldigiPath)libgcc_s_seh-1.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibiconv2" Source="$(var.FldigiPath)libiconv-2.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibintl8" Source="$(var.FldigiPath)libintl-8.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibjpeg8" Source="$(var.FldigiPath)libjpeg-8.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibmp3lame0" Source="$(var.FldigiPath)libmp3lame-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibmpg1230" Source="$(var.FldigiPath)libmpg123-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibogg0" Source="$(var.FldigiPath)libogg-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibopus0" Source="$(var.FldigiPath)libopus-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibpng1616" Source="$(var.FldigiPath)libpng16-16.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibportaudio" Source="$(var.FldigiPath)libportaudio.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibsamplerate0" Source="$(var.FldigiPath)libsamplerate-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibsndfile1" Source="$(var.FldigiPath)libsndfile-1.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibstdcpp6" Source="$(var.FldigiPath)libstdc++-6.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibvorbis0" Source="$(var.FldigiPath)libvorbis-0.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibvorbisenc2" Source="$(var.FldigiPath)libvorbisenc-2.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiLibwinpthread1" Source="$(var.FldigiPath)libwinpthread-1.dll" KeyPath="yes" Checksum="yes"/></Component>
		<Component Guid="*"><File Id="FldigiZlib1" Source="$(var.FldigiPath)zlib1.dll" KeyPath="yes" Checksum="yes"/></Component>
	</ComponentGroup>

	<!-- LSP VST3 plugin suite installed to Common Files\VST3.
	     Components are Permanent so uninstalling Thetis does not remove plugin
	     files that other VST3 hosts may also use. -->
    <ComponentGroup Id="LspComponents" Directory="VST3Folder">
      <Component Id="LspPluginsVST3" Guid="*" Permanent="yes">
        <File Id="LspPluginsVST3File"
              Source="$(var.LspPath)lsp-plugins.vst3"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
      <Component Id="LspLibwinpthreadDLL" Guid="*" Permanent="yes">
        <File Id="LspLibwinpthreadDLLFile"
              Source="$(var.LspPath)libwinpthread-1.dll"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
      <Component Id="LspR3dWglLibDLL" Guid="*" Permanent="yes">
        <File Id="LspR3dWglLibDLLFile"
              Source="$(var.LspPath)lsp-r3d-wgl-lib.dll"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
      <Component Id="LspAttribution" Guid="*" Permanent="yes">
        <File Id="LspAttributionTXT"
              Source="$(var.LspPath)ATTRIBUTION.txt"
              KeyPath="yes" />
      </Component>
      <Component Id="LspLicenseLgpl" Guid="*" Permanent="yes">
        <File Id="LspLicenseLgplTXT"
              Source="$(var.LspPath)LICENSE-LGPL-3.0.txt"
              KeyPath="yes" />
      </Component>
      <Component Id="LspLicenseWinpthread" Guid="*" Permanent="yes">
        <File Id="LspLicenseWinpthreadTXT"
              Source="$(var.LspPath)LICENSE-libwinpthread.txt"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Binary Id="InstallSkins" SourceFile="OpenHPSDR_Skins.exe" />
    <CustomAction Id="InstallSkins_CA" BinaryKey="InstallSkins"
        Impersonate="yes" Execute="deferred" ExeCommand="[SystemFolder]cmd.exe /C start OpenHPSDR_Skins.exe &amp; exit"
                  Return="check"/>

	  <Binary Id="InstallMeterSkins" SourceFile="MeterSkinInstaller.exe" />
	  <CustomAction Id="InstallMeterSkins_CA" BinaryKey="InstallMeterSkins"
		  Impersonate="yes" Execute="deferred" ExeCommand="[SystemFolder]cmd.exe /C start MeterSkinInstaller.exe"
					Return="check"/>

    <InstallExecuteSequence>
      <Custom Action='InstallSkins_CA' Before='InstallFinalize'>
        NOT Installed
      </Custom>
    </InstallExecuteSequence>

	  <InstallExecuteSequence>
		  <Custom Action='InstallMeterSkins_CA' Before='InstallFinalize'>
			  NOT Installed
		  </Custom>
	  </InstallExecuteSequence>
	  
    <!--   -->
  </Fragment>

  <!-- wsjtx sidecar payload: prebuilt exe + runtime DLLs + Qt plugins shipped
       from the git-tracked payload\WsjtX folder.  Installed to
       [INSTALLFOLDER]\WsjtX so WsjtManager.ResolveExecutable() resolves them as
       the primary probe.  Refresh payload\WsjtX on every wsjtx rebuild. -->
  <Fragment>
    <DirectoryRef Id="WsjtXDir">
      <Directory Id="WsjtXPluginsDir" Name="plugins">
        <Directory Id="WsjtXPluginsAudioDir" Name="audio"/>
        <Directory Id="WsjtXPluginsImageformatsDir" Name="imageformats"/>
        <Directory Id="WsjtXPluginsMediaserviceDir" Name="mediaservice"/>
        <Directory Id="WsjtXPluginsPlatformsDir" Name="platforms"/>
        <Directory Id="WsjtXPluginsPlaylistformatsDir" Name="playlistformats"/>
        <Directory Id="WsjtXPluginsPrintsupportDir" Name="printsupport"/>
        <Directory Id="WsjtXPluginsSqldriversDir" Name="sqldrivers"/>
        <Directory Id="WsjtXPluginsStylesDir" Name="styles"/>
      </Directory>
    </DirectoryRef>
  </Fragment>

