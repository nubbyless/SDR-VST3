              />
		</Component>

		<!-- 
		NAudio
		-->
		<Component Guid="*">
			<File Id="NAudio"
				  Source="$(var.FilesPath)NAudio.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="NAudio.Asio"
				  Source="$(var.FilesPath)NAudio.Asio.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
