              KeyPath="yes"
			  Checksum="yes"
              />
      </Component>

		<!-- [4.7] System.Buffers, SharpDX.Desktop removed: inbox / replaced by Vortice -->

		<Component Guid="*">
			<File Id="Newtonsoft.JsonDLL"
				  Source="$(var.FilesPath)Newtonsoft.Json.dll"
				  KeyPath="yes"
              />
		</Component>

		<Component Guid="*">
