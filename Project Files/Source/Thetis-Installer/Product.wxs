		<!-- 
		NAudio end
		-->
		
		<!-- 
		Additional
		-->
		<!-- [4.7] System.Numerics.Vectors, System.Runtime.CompilerServices.Unsafe,
		     System.Text.Encoding.CodePages, System.Threading.Tasks.Extensions,
		     System.Drawing.Common removed: inbox in .NET 10 -->
		<Component Guid="*">
			<File Id="HtmlAgilityPackDLL"
				  Source="$(var.FilesPath)HtmlAgilityPack.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="SkiaSharpDLL"
				  Source="$(var.FilesPath)SkiaSharp.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="ExCSSDLL"
				  Source="$(var.FilesPath)ExCSS.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="SvgDLL"
				  Source="$(var.FilesPath)Svg.dll"
				  KeyPath="yes"
              />
		</Component>
		<!-- 
		Additional end
		-->

		<!-- 
		Binding Redirects / runtime config. [4.6] .NET 10 migration: the config file
		is now emitted next to the managed assembly as Thetis.dll.config (there is no
		native Thetis.exe.config anymore). Checksummed so it always installs if changed.
		-->
		<Component Guid="*">
			<File Id="Thetis.dll.config"
				  Source="$(var.FilesPath)Thetis.dll.config"
				  KeyPath="yes"
				  Checksum="yes"
              />
		</Component>
		<!-- 
		End Thetis.exe.config
		-->
		
		<!-- 
		CodeAnalysis for Led/MultiMeter
		-->
		<Component Guid="*">
			<File Id="Microsoft.CodeAnalysisDLL"
				  Source="$(var.FilesPath)Microsoft.CodeAnalysis.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Microsoft.CodeAnalysis.CSharpDLL"
				  Source="$(var.FilesPath)Microsoft.CodeAnalysis.CSharp.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Microsoft.CodeAnalysis.CSharp.Scripting"
				  Source="$(var.FilesPath)Microsoft.CodeAnalysis.CSharp.Scripting.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Microsoft.CodeAnalysis.ScriptingDLL"
				  Source="$(var.FilesPath)Microsoft.CodeAnalysis.Scripting.dll"
				  KeyPath="yes"
              />
		</Component>
		<!-- [4.7] System.Collections.Immutable, System.Reflection.Metadata removed: inbox in .NET 10 -->
		<!-- 
		End CodeAnalysis for Led/MultiMeter section
		-->

		<!-- 
		Discord
		-->
		<Component Guid="*">
			<File Id="Discord.Net.CommandsDLL"
				  Source="$(var.FilesPath)Discord.Net.Commands.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Discord.Net.CoreDLL"
				  Source="$(var.FilesPath)Discord.Net.Core.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Discord.Net.InteractionsDLL"
				  Source="$(var.FilesPath)Discord.Net.Interactions.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Discord.Net.RestDLL"
				  Source="$(var.FilesPath)Discord.Net.Rest.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Discord.Net.WebhookDLL"
				  Source="$(var.FilesPath)Discord.Net.Webhook.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Discord.Net.WebSocketDLL"
				  Source="$(var.FilesPath)Discord.Net.WebSocket.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="Microsoft.Extensions.DependencyInjection.AbstractionsDLL"
				  Source="$(var.FilesPath)Microsoft.Extensions.DependencyInjection.Abstractions.dll"
				  KeyPath="yes"
              />
		</Component>
		<!-- [4.7] System.CodeDom removed: inbox in .NET 10 -->
		<Component Guid="*">
			<File Id="System.Interactive.AsyncDLL"
				  Source="$(var.FilesPath)System.Interactive.Async.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="System.Linq.AsyncDLL"
				  Source="$(var.FilesPath)System.Linq.Async.dll"
				  KeyPath="yes"
              />
		</Component>
		<Component Guid="*">
			<File Id="System.ReactiveDLL"
				  Source="$(var.FilesPath)System.Reactive.dll"
				  KeyPath="yes"
              />
		</Component>
		<!-- 
		End Discord
		-->
		
		<!-- [4.7] Legacy .NET Framework polyfills removed: inbox in .NET 10 -->
		<Component Guid="*">
			<File Id="MicrosoftNETStringToolsDLL"
				  Source="$(var.FilesPath)Microsoft.NET.StringTools.dll"
				  KeyPath="yes"
              />
		</Component>
		<!-- [4.7] System.Formats.Nrbf, System.Linq.AsyncEnumerable removed: inbox in .NET 10 -->
		<!-- [4.7] System.Resources.Extensions removed: inbox in .NET 10 -->
		
		<!-- [4.7] SharpDX removed: replaced by Vortice.Windows -->
		<Component Guid="*">
			<File Id="WindowsFirewallHelperDLL"
				  Source="$(var.FilesPath)WindowsFirewallHelper.dll"
				  KeyPath="yes"
              />
		</Component>
      <Component Guid="*">
        <File Id="FTDI2xxDLL"
            Source="$(var.FilesPath)FTDI2XX.dll"
            KeyPath="yes"
              />
      </Component>
		
      <Component Guid="*">
